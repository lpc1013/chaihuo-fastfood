# —— Godot 编辑器缓存：每次 --import 重建，309MB
.godot/

# —— 导出产物。只排二进制，包里的《使用说明.txt》和《启动游戏.bat》要入库
#    （它们不在 pck 里，是散文件，用户双击的就是那个 .bat）
builds/windows/*.exe
builds/windows/*.pck

# —— 自检输出与调试取证：都是跑出来的，不是写出来的
screenshots/
tools/_scratch/
deliverables/
__pycache__/
*.log

# —— 即梦原始候选图（89MB）。正式素材只留 assets/art 里选中那一张
assets/incoming/

# —— 早被推翻的 HTML 原型（207MB），只在文档里被历史引用
legacy_web_v1/

# —— 编辑器跑法下的存档/台账，属玩家数据不是代码
saves/

.DS_Store
Thumbs.db
